generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Member {
  id        Int    @id @default(autoincrement())
  name      String
  surname   String
  phone     String?
  email     String?
  role      String
  createdAt DateTime @default(now())
}